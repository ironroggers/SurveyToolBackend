PORT=3010
MONGODB_URI=mongodb://localhost:27017/execution-db
# The auth service's JWT_SECRET: every /api route checks the login token with it
JWT_SECRET=REPLACE_ME

# AWS S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
S3_BUCKET=your-bucket
S3_PREFIX=execution
# Optional: an S3-compatible endpoint for local development (MinIO etc.); leave unset for AWS
# S3_ENDPOINT=http://localhost:9000



# OFC execution (optional; defaults shown)
EXEC_ACCURACY_LIMIT_M=1
EXEC_ALLOW_MEDIA_UPLOAD=true
EXEC_VIDEO_MAX_SEC=60
